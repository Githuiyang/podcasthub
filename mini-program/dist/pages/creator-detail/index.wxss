.page-cd{background-color:#f9fafb;min-height:100vh}.cd-header{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-ms-flex-align:center;align-items:center;background-color:#fff;margin-bottom:16rpx;padding:40rpx 32rpx 32rpx}.cd-header--skeleton{-webkit-align-items:flex-start;-webkit-flex-direction:row;-ms-flex-direction:row;flex-direction:row;-ms-flex-align:start;align-items:flex-start;padding:32rpx}.sk-circle{background-color:#f3f4f6;border-radius:80rpx;-webkit-flex-shrink:0;height:160rpx;margin-right:24rpx;width:160rpx;-ms-flex-negative:0;flex-shrink:0}.sk-lines{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex:1;-ms-flex:1;flex:1;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:16rpx;padding-top:20rpx}.sk-bar{background-color:#f3f4f6;border-radius:4rpx}.sk-bar--lg{height:28rpx;width:70%}.sk-bar--md{height:22rpx;width:50%}.sk-bar--sm{height:18rpx;width:30%}.cd-avatar{border-radius:80rpx;height:160rpx;margin-bottom:20rpx;width:160rpx}.cd-avatar--placeholder{-webkit-align-items:center;background-color:#f3f4f6;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.cd-avatar-letter{color:#6b7280;font-size:56rpx;font-weight:600}.cd-name{color:#111827;font-size:36rpx;font-weight:700;margin-bottom:12rpx}.cd-company-badge,.cd-status-badge,.cd-type-badge{border-radius:999rpx;font-size:24rpx;margin-bottom:12rpx;padding:4rpx 16rpx}.cd-type-badge{background-color:#f3f4f6;color:#6b7280}.cd-status-badge{background-color:#f0fdf4;color:#059669}.cd-company-badge{background-color:#eff6ff;color:#1d4ed8}.cd-tags{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:8rpx;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;margin-bottom:12rpx}.cd-tag{background-color:#f3f4f6;border-radius:6rpx;color:#6b7280;font-size:22rpx;padding:4rpx 12rpx}.cd-bio{color:#6b7280;font-size:26rpx;line-height:1.6;max-width:600rpx;text-align:center}.cd-section{background-color:#fff;border-bottom:1rpx solid #f3f4f6;padding:24rpx 32rpx}.cd-section--skeleton{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:12rpx}.cd-label{color:#9ca3af;display:block;font-size:24rpx;margin-bottom:12rpx}.cd-value{color:#111827;display:block;font-size:28rpx;line-height:1.6}.cd-value--block{display:block}.cd-value--link{color:#2563eb}.cd-quote{background-color:#f9fafb;border-left:6rpx solid #e5e7eb;border-radius:0 8rpx 8rpx 0;font-style:italic;padding:16rpx}.cd-chips{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:10rpx}.cd-chip{background-color:#f3f4f6;border-radius:8rpx;color:#374151;font-size:24rpx;padding:6rpx 16rpx}.cd-images{white-space:nowrap}.cd-img{border-radius:12rpx;display:inline-block;height:180rpx;margin-right:12rpx;width:240rpx}.cd-error{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;padding:120rpx 48rpx}.cd-error-text{color:#6b7280;font-size:28rpx;margin-bottom:24rpx}.cd-error-btn{background-color:#111827;border-radius:12rpx;padding:16rpx 40rpx}.cd-error-btn:active{opacity:.85}.cd-error-btn-text{color:#fff;font-size:28rpx}.cd-bottom{height:60rpx}