.page-submit{background-color:#f9fafb;min-height:100vh;padding:32rpx}.submit-card{background-color:#fff;border-radius:16rpx;padding:40rpx 32rpx}.submit-title{color:#111827;display:block;font-size:36rpx;font-weight:700;margin-bottom:20rpx}.submit-desc{color:#6b7280;display:block;font-size:26rpx;line-height:1.6;margin-bottom:32rpx}.submit-steps{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:12rpx;margin-bottom:40rpx}.step-text{color:#374151;font-size:24rpx}.submit-btn{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;background-color:#111827;border-radius:14rpx;height:88rpx;justify-content:center}.submit-btn:active{opacity:.85}.submit-btn-text{color:#fff;font-size:28rpx;font-weight:500}