# PodcastHub 后端生产环境变量

# 应用
DEBUG=false
AUTO_INIT_DB=false

# 数据库
# 推荐使用 Supabase Session Pooler 或其他公网 Postgres 连接串
DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres

# CORS
# 仅放行正式前端域名
CORS_ALLOW_ORIGINS=https://daydayup.media

# 反馈
# 飞书机器人 Webhook；不填则反馈接口会返回降级提示
FEISHU_WEBHOOK_URL=

# 可选：如果你在 systemd / 手动启动时想统一覆盖 gunicorn 参数，可保留这些
HOST=127.0.0.1
PORT=8000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

